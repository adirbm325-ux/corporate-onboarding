# Corporate Onboarding AI — משתני סביבה
#
# העתק/י קובץ זה ל-.env (ולא ל-.env.example!) ומלא/י את הערכים שלך.
#
# חשוב: קובץ .env זה *אופציונלי לגמרי*. אם משאירים אותו ריק, לא יוצרים
# אותו כלל, או שהחיבור לשרת נכשל מכל סיבה — האפליקציה ממשיכה לעבוד
# באופן מלא מול localStorage בדפדפן, בדיוק כפי שעבדה עד כה. שום מסך או
# פיצ'ר לא דורש בפועל את המשתנים האלה.

# כתובת ה-URL של פרויקט ה-Supabase שלך (Project Settings → API → Project URL)
VITE_SUPABASE_URL=

# מפתח ה-anon/public של הפרויקט (Project Settings → API → anon public key)
# אין להשתמש כאן במפתח ה-service_role בשום מקרה — הוא לא מיועד לצד לקוח.
VITE_SUPABASE_ANON_KEY=
